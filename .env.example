# Provedor inicial econômico. Use openai para mudar.
FBR_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Opcional: whisper-large-v3-turbo ou whisper-large-v3 para Groq;
# gpt-4o-mini-transcribe, gpt-4o-transcribe ou whisper-1 para OpenAI.
FBR_MODEL=
# Usuário e senha de acesso ao aplicativo. Defina uma senha com 12+ caracteres.
FBR_USERNAME=fbr
FBR_PASSWORD=
FBR_DATA_DIR=/data
FBR_MAX_DURATION_SECONDS=3600
FBR_MAX_DOWNLOAD_MB=150
FBR_MAX_QUEUE=10
FBR_JOB_TIMEOUT_SECONDS=1800
FBR_RETENTION_HOURS=24
# Cookies opcionais: caminho de um arquivo Netscape montado somente para leitura.
FBR_COOKIES_FILE=
# Somente para uma publicação deliberadamente pública; mantém o limite de fila.
FBR_ALLOW_PUBLIC=0
# Opcional: chave estável para criptografar sessões; se vazia, deriva da FBR_PASSWORD.
# Mudar a chave/senha invalida sessões antigas e exige reimportá-las.
FBR_SESSION_SECRET=
# Integração opcional com Firefox remoto. Veja docs/navegador-remoto.md.
FBR_BROWSER_PROFILE=
FBR_BROWSER_URL=
